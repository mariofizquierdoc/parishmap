{
  "name": "parishmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently --raw \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run db:generate -w server && npm run build -w web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e/tsconfig.json",
    "test:e2e": "playwright test",
    "start": "npm run start -w server",
    "backup": "npm run backup -w server",
    "test:e2e:prod": "npm run build && playwright test --config=playwright.prod.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true
  }
}
