# Copy to server/.env for local development.

# SQLite database file. Relative paths are resolved from the server/ folder.
DATABASE_URL="file:./data/parishmap.db"

# API server port. The Vite dev server proxies /api to this port.
PORT=3001

# Admin login. Run `npm run admin:create -w server` to generate these three lines.
# ADMIN_USERNAME=''
# ADMIN_PASSWORD_HASH=''
# SESSION_SECRET=''

# Optional satellite layer for the admin editor. Check that the provider's terms allow tracing.
# SATELLITE_TILE_URL='https://example.com/tiles/{z}/{x}/{y}.jpg?key=YOUR_KEY'
# SATELLITE_ATTRIBUTION='Imagery © Example'
